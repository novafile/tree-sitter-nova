{
  "name": "@novafile/tree-sitter-nova",
  "version": "0.2.0",
  "description": "NOVA (Notation for Objects, Values & Agents) grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novafile/tree-sitter-nova.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "NOVA contributors"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "nova"
  ],
  "files": [
    "grammar.js",
    "common/*",
    "schema/grammar.js",
    "tree-sitter.json",
