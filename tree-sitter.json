{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nova",
      "camelcase": "Nova",
      "title": "NOVA",
      "scope": "source.nova",
      "file-types": [
        "nova"
      ],
      "injection-regex": "^nova$",
      "class-name": "TreeSitterNova",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm",
      "path": "."
    },
    {
      "name": "nova_schema",
      "camelcase": "NovaSchema",
      "title": "NOVA schema",
      "scope": "source.novs",
      "path": "schema",
      "file-types": [
        "novs"
      ],
      "injection-regex": "^(novs|nova_schema)$",
      "class-name": "TreeSitterNovaSchema",
      "highlights": "schema/queries/highlights.scm",
      "locals": "schema/queries/locals.scm"
    },
    {
      "name": "nova_lines",
      "camelcase": "NovaLines",
      "title": "NOVA Lines",
      "scope": "source.novl",
      "path": "lines",
      "file-types": [
        "novl"
      ],
      "injection-regex": "^(novl|nova_lines)$",
      "class-name": "TreeSitterNovaLines",
      "highlights": "lines/queries/highlights.scm",
      "locals": [],
      "injections": []
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "Apache-2.0",
    "description": "NOVA (Notation for Objects, Values & Agents) grammar for tree-sitter",
    "authors": [
      {
        "name": "NOVA contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/novafile/tree-sitter-nova"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
